# name: test/sql/parser/at_keyword_identifier.test
# description: AT can be used as an unquoted identifier while AT TIME ZONE and time travel still parse
# group: [parser]

statement ok
CREATE TABLE t1(at TIMESTAMP)

statement ok
CREATE TABLE t3(x INTEGER, at INTEGER)

statement ok
INSERT INTO t3 VALUES (1, 2)

query II
SELECT x, at FROM t3
----
1	2

query I
SELECT at FROM t3 WHERE at = 2
----
2

query I
SELECT s.at FROM (SELECT 5 AS at) s
----
5

query I
SELECT at.x FROM t3 AS at
----
1

query I
SELECT at.x FROM t3 at
----
1

query II
SELECT a, b FROM t3 at(a, b)
----
1	2

statement error
SELECT * FROM t3 AT (VERSION => 42)
----
time travel

statement error
SELECT * FROM t3 x AT (TIMESTAMP => TIMESTAMP '2020-01-01')
----
time travel

statement ok
CREATE TABLE t2("at" TIMESTAMP)

query I
SELECT keyword_category FROM duckdb_keywords() WHERE keyword_name = 'at'
----
unreserved
